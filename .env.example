# ---- Required ---------------------------------------------------------------
# Supabase Postgres connection string. On Vercel use the *transaction pooler* URI
# (Supabase Dashboard -> Connect -> Transaction pooler, port 6543) so serverless
# functions do not exhaust connections. Locally the direct URI (port 5432) is fine.
DATABASE_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# Supabase project URL and the SERVICE ROLE key (Dashboard -> Project Settings -> API).
# The service role key bypasses Row Level Security: it is used server-side only and must never
# reach the browser or be committed.
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# 32 random bytes, base64. Encrypts SSNs, MFA secrets and every per-file data key.
# Generate with: npm run gen-keys. NEVER change after data exists; back it up separately.
APP_ENCRYPTION_KEY=
# 32+ random bytes, base64. Signs device cookies.
SESSION_SECRET=

# Connection used ONLY for migrations (npm run db:migrate, also during the Vercel build). Use the
# *Session pooler* URI (same pooler host, port 5432) or the direct connection. Optional: falls back
# to DATABASE_URL. The direct host db.<ref>.supabase.co is IPv6-only on most plans, so prefer the
# session pooler from Vercel.
DIRECT_DATABASE_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# ---- First-admin bootstrap (temporary) -------------------------------------------
# Long random string. While set AND the users table is empty, /setup lets you create the first
# Owner/Admin in the browser. Generate: openssl rand -base64 32. REMOVE this variable and redeploy
# as soon as the first admin exists.
BOOTSTRAP_TOKEN=

# ---- Recommended -------------------------------------------------------------
# Public URL used when building magic links (no trailing slash). Falls back to VERCEL_URL.
BASE_URL=https://internal.taxonomy.example
# Private bucket for the encrypted document vault (created by: npm run storage:setup).
SUPABASE_STORAGE_BUCKET=vault
# Random secret Vercel Cron sends as "Authorization: Bearer ..." to /api/cron/cleanup.
CRON_SECRET=

# ---- Security switches -----------------------------------------------------
# Secure cookie flag. Defaults to true on Vercel; MUST be true when NODE_ENV=production (the app
# refuses to start otherwise). Set to false only for plain-http local development.
COOKIE_SECURE=true
# Read client IPs from X-Forwarded-For. Defaults to true on Vercel; set true behind any proxy.
TRUST_PROXY=true
NODE_ENV=production

# ---- Optional ------------------------------------------------------------------
PORT=3000
# Max Postgres connections per instance (default 2 on Vercel, 5 elsewhere).
DB_POOL_MAX=2
# SMTP for admin alerts and portal-link email. If unset, email is recorded in Admin -> Email outbox.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Taxonomy <no-reply@example.com>"

# ---- Tests ---------------------------------------------------------------------
# Postgres the test suite may create/drop throwaway databases in (defaults to a local server).
# TEST_DATABASE_URL=postgres://postgres@127.0.0.1:5432/postgres
