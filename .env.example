# Copy to .env and fill in. Generate keys with: npm run gen-keys
NODE_ENV=development
PORT=3000
# Public base URL used when building magic links (no trailing slash)
BASE_URL=http://localhost:3000
# Directory for the SQLite database and encrypted uploads
DATA_DIR=./data
# 32 random bytes, base64. Encrypts SSNs, MFA secrets and uploaded files at rest. NEVER change after data exists.
APP_ENCRYPTION_KEY=
# 32+ random bytes, base64. Signs device cookies.
SESSION_SECRET=
# Set to "true" only when running behind HTTPS (sets Secure cookie flag). Strongly recommended in production.
COOKIE_SECURE=false
# If the app runs behind a reverse proxy (nginx, Caddy, load balancer), set to "true" so client IPs are read from X-Forwarded-For.
TRUST_PROXY=false
# Optional SMTP for admin alerts and magic-link email. If unset, outgoing email is written to the Admin > Email outbox instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Taxonomy <no-reply@example.com>"
