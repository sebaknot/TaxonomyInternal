{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build && npm run db:migrate",
  "framework": null,
  "functions": {
    "api/index.js": {
      "includeFiles": "dist/src/views/**",
      "maxDuration": 30,
      "memory": 1024
    }
  },
  "rewrites": [
    { "source": "/static/(.*)", "destination": "/static/$1" },
    { "source": "/(.*)", "destination": "/api" }
  ],
  "crons": [{ "path": "/api/cron/cleanup", "schedule": "0 4 * * *" }]
}
